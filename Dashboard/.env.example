# Base URL of the LSA backend REST API (includes the /api/v1 prefix).
#
# Local dev default: relative "/api/v1", proxied to http://localhost:3000 by
# Vite (see vite.config.ts server.proxy). This is required, not cosmetic —
# the backend's auth cookies are httpOnly + SameSite=Lax, so a direct
# cross-port request from the dev server would never carry them; the proxy
# makes the browser see everything as same-origin.
#
# In an environment where the dashboard is reverse-proxied behind the same
# origin as the API, keep this relative. If the dashboard is genuinely
# cross-origin from the API (separate domains), set the full absolute URL
# instead and the backend's CORS configuration must allow it with
# credentials — see the backend CORS gap noted in the analysis report.
VITE_API_BASE_URL=/api/v1

# Origin of the LSA backend Socket.IO server. Optional — leave empty/unset
# for same-origin (the socket connects to whatever origin served the page,
# proxied to the backend by Vite in dev — see vite.config.ts server.proxy —
# or by the production reverse proxy under strategy A). This must match the
# REST API's same-origin requirement: the socket handshake's auth cookie is
# scoped to whichever origin the browser thinks it's talking to, so a direct
# cross-port/cross-origin connection would never carry it. Only set this to
# an absolute URL for a genuine cross-origin deployment (strategy B), same
# as VITE_API_BASE_URL above.
VITE_SOCKET_URL=
